@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Strings
@{
	Layout = "~/Views/Master.cshtml";
	var nyheter = Umbraco.ContentAtRoot().FirstOrDefault(x => x.Name == "Nyheter");

    var newsArticles = nyheter?.Children()
        .Where(x => x.ContentType.Alias == "newsArticle")
        ?? Enumerable.Empty<IPublishedContent>();
}

<section class="articles">
    <div class="articles__grid">
        @foreach (var article in newsArticles)
        {
            var thumbnail = article.Value<MediaWithCrops>("thumbnail");
            var title = article.Value<string>("title");
            var excerpt = article.Value<HtmlEncodedString>("breadtext");
            var authors = article.Value<IEnumerable<IPublishedContent>>("authors") ?? Enumerable.Empty<IPublishedContent>();
            var subjects = article.Value<IEnumerable<IPublishedContent>>("subjectTags") ?? Enumerable.Empty<IPublishedContent>();

            <article class="card">
                <a class="card__link" href="@article.Url()">
                    @if (thumbnail != null)
                    {
                        <img class="card__image"
                             src="@thumbnail.GetCropUrl(width: 600, height: 400)"
                             alt="@article.Name" />
                    }

                    <div class="card__body">
                        <h2 class="card__title">@article.Value("title")</h2>
                        <p class="card__excerpt">@article.Value("excerpt")</p>
                    </div>
                </a>
            </article>
        }
    </div>
</section>

