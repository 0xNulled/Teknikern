@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager
@inject Umbraco.Cms.Core.Services.IMemberService MemberService
@inject Umbraco.Cms.Core.Services.IMediaService MediaService
@using Teknikern.Controllers
@using Teknikern.Utils
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common.Models
@using Umbraco.Cms.Web.Website.Controllers
@using Umbraco.Extensions
@{
	Layout = "~/Views/Master.cshtml";
	var siteSettings = Umbraco.ContentAtRoot()
			.FirstOrDefault(x => x.ContentType.Alias == "siteSettings");
	var defaultAvatar = siteSettings?.Value<MediaWithCrops>("defaultAvatar");
	var defaultAvatarUrl = defaultAvatar?.Url();

	var isLoggedIn = Context.User.GetMemberIdentity()?.IsAuthenticated ?? false;
	var logoutModel = new PostRedirectModel();
	logoutModel.RedirectUrl = "/";
	var currentUser = await MemberManager.GetCurrentMemberAsync();
	var member = currentUser != null
		? MemberService.GetByEmail(currentUser.Email!)
		: null;

	var memberName = member?.Name;
	var memberEmail = member!.Email;

	var imageUrl = MemberAvatarUtil.GetProfilePictureUrl(MemberService.GetByEmail(memberEmail), MediaService)
											 ?? defaultAvatarUrl;
}


@if (isLoggedIn)
{
	<div style="display: flex; align-items: center; justify-content: center;">
		<div
			style="display: flex; align-items: center; max-height: 50vh; margin: 50px; border: solid white 1px; width: 500px; padding: 20px; position: relative;">
			<section style="position: relative;">
				@if (!string.IsNullOrEmpty(imageUrl))
				{
					<img src="@imageUrl" alt="Profile picture"
							 style="width: 150px; height: 150px; object-fit: cover; border-radius:50%;" />
				}
				else
				{
					<img src="@defaultAvatarUrl" alt="Profile picture"
							 style="width: 150px; height: 150px; object-fit: cover; border-radius:50%;" />
				}
				
				@using (Html.BeginUmbracoForm<MemberProfileController>(
						"UploadProfilePicture",
						FormMethod.Post,
						new { enctype = "multipart/form-data" }))
				{
					<label for="profilePicture" style="cursor:pointer; display:block;">
						<div class="light-link" style="width: 32px; height: 32px; background: black; border-radius: 50%; position: absolute; bottom: 5px; right: 5px; border: solid 1px white; display: flex;
							align-items: center; justify-content: center; color: white;">&#x1F58A;
						</div>
					</label>

					<input type="file" id="profilePicture" name="profilePicture" accept="image/jpeg,image/png,image/webp"
								 style="display:none;" onchange="this.form.submit();" />
				}

			</section>
			<section style=" margin:20px;">
				<p><strong>@memberName</strong></p>
				<p><strong>@Context.User?.GetMemberIdentity()?.Name</strong></p>
				<section style="position: absolute; bottom: 15px; right: 15px;">
					@using (Html.BeginUmbracoForm<UmbLoginStatusController>("HandleLogout", new
					{
						RedirectUrl = logoutModel.RedirectUrl
					}))
					{
						<button type="submit" class="primary-btn">
							Logga ut
						</button>
					}
				</section>
			</div>
		</div>
	}