@using Teknikern.Controllers
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "~/Views/Master.cshtml";
	var image = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("thumbnail");
	var authors = Model.Value<IEnumerable<IPublishedContent>>("authors") ?? Enumerable.Empty<IPublishedContent>();
	var subjects = Model.Value<IEnumerable<IPublishedContent>>("subjectTags") ?? Enumerable.Empty<IPublishedContent>();
	var articleId = Model.Id;
	var isLoggedIn = Context.User.GetMemberIdentity()?.IsAuthenticated ?? false;
	string? memberName = ((await MemberManager.GetCurrentMemberAsync())?.Name);

	var allComments = Model.Children().Where(x => x.ContentType.Alias == "articleComment")
	.OrderByDescending(x => x.Value<DateTime>("commentDate"));
	var commentCount = Model.Children().Count(x => x.ContentType.Alias == "articleComment");
}

@if (subjects.Any())
{
	<div class="news-card__tags" style="margin-bottom: 20px; margin-top: 5%; width: 30%; margin-left: 25%">
		@foreach (var subject in subjects)
		{
			<span class="tag">@(subject.Value<string>("subject"))</span>
		}
	</div>
}
<h1 style="margin-bottom: 40px; width: 50%; margin-left: 25%">@Model.Name
	<span class="news-card__author" style="margin-top: 20px;">
		@{
			foreach (var author in authors)
			{
				var headshot = author.Value<IPublishedContent>("headshot");
        
				if (headshot != null)
				{
					<img src="@headshot.Url()" height="32px" width="32px"
							 style="border-radius: 100%; border: 1px solid #adad1f; flex-shrink: 0; object-fit: cover; padding: 2px; margin-right: 5px;" />
				}
			}
			@string.Join(", ", authors.Select(author => author.Value<string>("fullName")))
		}
	</span>
</h1>

@if (image != null)
{
	<img src="@image.Url()" alt="@Model.Name" height="auto" width="65%" style="max-width: 100%;
	height: auto;
	display: block;
	margin: 0 auto;
	border: 1px solid #adad1f;
	padding: 5px" />
}

<article class="news-article">
	@Model.Value("breadtext")
</article>

<div class="comments-section" style="width: 65%; margin: 40px auto;">
	<h3>Comments (@commentCount)</h3>

	@foreach (var comment in allComments)
	{
		<div class="comment-card" style="padding: 15px; border-radius: 4px; background: white; margin-bottom: 20px">
			<p>
				<strong style="color: black; text-decoration: underline;">@comment.Value("commentAuthor") kommenterade:</strong>

			</p>
			<p style="color: black">@comment.Value("commentContent")</p>
			<p style="color: #666; font-size: 0.85em;">
				@((comment.Value<DateTime?>("commentDate"))?.ToString("yyyy-MM-dd HH:mm"))
			</p>
		</div>
	}
</div>
@if (isLoggedIn)
{
	<div>
		@using (Html.BeginUmbracoForm<CommentController>(nameof(CommentController.SubmitNewComment)))
		{
			<div style="display:flex; flex-direction: column; justify-content: center; align-items:center;">
				<p>Kommentera inlägget</p>

				<!-- Fylls automatiskt -->
				<input type="hidden" name="Id" value="@Model.Id" />
				<input type="hidden" name="Date" value="@DateTime.Now" />
				<input type="hidden" name="Author" value="@memberName" />
				<!-- Fylls automatiskt -->

				<div style="margin-bottom: 5px;">
					<textarea name="Content" rows="5" required
										style="width: 50vw; resize: none; padding: 20px; font-size: 16px; border-radius: 4px;"></textarea>
				</div>

				<button type="submit" class="primary-btn" style="margin-top: 20px; margin-bottom: 50px">
					Skicka kommentar
				</button>
			</div>
		}
	</div>
}
else
{
	<div
		style="display:flex; flex-direction: column; justify-content: center; align-items:center; margin-bottom: 70px; margin-top: 100px;">
		<a href="/logga-in">Logga in för att kommentera inlägget</a>
	</div>
	
}
