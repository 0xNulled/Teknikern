@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.NewsArticle>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = null;
}
<!doctype html>
<html lang="sv">

<head>
    <meta charset="utf-8">
    <title>@Model.Name</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h1 style="text-align: center; margin-bottom: 40px;">@Model.Name</h1>

	@{
		var image = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("thumbnail");
	}
	@if (image != null){
		<img src="@image.Url()">
	}

	

	<article>
		@Model.Value("breadtext")
	</article>
	
</body>
</html>