@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "~/Views/Master.cshtml";
	var image = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("thumbnail");
	var authors = Model.Value<IEnumerable<IPublishedContent>>("authors") ?? Enumerable.Empty<IPublishedContent>();
	var subjects = Model.Value<IEnumerable<IPublishedContent>>("subjectTags") ?? Enumerable.Empty<IPublishedContent>();
	var articleId = Model.Id;


}

@if (subjects.Any())
{
	<div class="news-card__tags" style="margin-bottom: 20px; margin-top: 5%; width: 30%; margin-left: 25%">
		@foreach (var subject in subjects)
		{
			<span class="tag">@(subject.Value<string>("subject"))</span>
		}
	</div>
}
<h1 style="margin-bottom: 40px; width: 50%; margin-left: 25%">@Model.Name
	<span class="news-card__author" style="margin-top: 20px;">
		@{
			foreach (var author in authors)
			{
				var headshot = author.Value<IPublishedContent>("headshot");
        
				if (headshot != null)
				{
					<img src="@headshot.Url()" height="32px" width="32px"
							 style="border-radius: 100%; border: 1px solid #adad1f; flex-shrink: 0; object-fit: cover; padding: 2px; margin-right: 5px;" />
				}
			}
			@string.Join(", ", authors.Select(author => author.Value<string>("fullName")))
		}
	</span>
</h1>

@if (image != null)
{
	<img src="@image.Url()" alt="@Model.Name" height="auto" width="65%" style="max-width: 100%;
	height: auto;
	display: block;
	margin: 0 auto;
	border: 1px solid #adad1f;
	padding: 5px" />
}

<article class="news-article">
	@Model.Value("breadtext")
</article>

<div>
	@{
		<comment>@articleId</comment>
	}
</div>
<div
	style="margin-left: auto; margin-right: auto; display: flex; flex-direction: column; width: 50%; justify-content: center; align-items: center; gap: 10px; margin-bottom: 100px;">
	<label>Kommentera denna artikeln</label>
	<textarea class="comment-box" style="resize: none; width: 100%; height: 200px; font-size: 20px;"></textarea>
	<button class="primary-btn">Skicka</button>
</div>

<style>
	.comment-box:focus {
		outline: 3px solid #e0e052;
	}
</style>
