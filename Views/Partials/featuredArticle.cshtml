@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Strings
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
  var siteSettings = Umbraco.ContentAtRoot()
      .FirstOrDefault(x => x.ContentType.Alias == "siteSettings");
    
  var thumbnail = Model.Value<MediaWithCrops>("thumbnail");
  var title = Model.Value<string>("title");
  var excerpt = Model.Value<HtmlEncodedString>("breadtext");
  var authors = Model.Value<IEnumerable<IPublishedContent>>("authors") ?? Enumerable.Empty<IPublishedContent>();
  var subjects = Model.Value<IEnumerable<IPublishedContent>>("subjectTags") ?? Enumerable.Empty<IPublishedContent>();
  var defaultAvatar = siteSettings?.Value<MediaWithCrops>(alias: "defaultAvatar");
}

<div
  style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 30px; padding: 20px; max-width: 1200px; margin: 40px auto;">

  <a class="light-link" style="flex: 1; min-width: 280px; text-decoration: none;" href="@Model.Url()">
    <div class="news-card__body">
      @if (subjects.Any())
      {
        <div class="news-card__tags" style="margin-bottom: 10px;">
          @foreach (var subject in subjects)
          {
            <span class="tag">@(subject.Value<string>("subject"))</span>
          }
        </div>
      }

      <h2 style="margin-bottom: 15px;">@title</h2>

      @if (excerpt != null)
      {
        <div class="news-card__excerpt" style="margin-bottom: 15px;">@excerpt</div>
      }

      <span class="news-card__author" style="display: flex; align-items: center; flex-wrap: wrap; gap: 5px;">
        @{
          foreach (var author in authors)
          {
            var headshot = author.Value<IPublishedContent>("headshot");
        
            if (headshot != null)
            {
              <img src="@headshot.Url()" height="32px" width="32px"
                   style="border-radius: 100%; border: 1px solid #adad1f; flex-shrink: 0; object-fit: cover; padding: 2px;" />
            }
            else if (defaultAvatar != null)
            {
              <img src="@defaultAvatar.Url()" height="32px" width="32px"
                   style="border-radius: 100%; border: 1px solid #adad1f; flex-shrink: 0; object-fit: cover; padding: 2px;" />
            }
          }
          <span>@string.Join(", ", authors.Select(author => author.Value<string>("fullName")))</span>
        }
      </span>
    </div>
  </a>

  @if (thumbnail != null)
  {
    <div style="flex: 1; min-width: 280px; text-align: center;">
      <img src="@thumbnail.Url()" alt="@title"
           style="width: 100%; max-width: 500px; height: auto; max-height: 300px; object-fit: cover;" />
    </div>
  }
</div>