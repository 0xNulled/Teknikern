@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
    const int pageSize = 8;

    var selectedTag = Context.Request.Query["tag"].FirstOrDefault();

    var articles = Model.Children()
        .Where(c => c.ContentType.Alias == "newsArticle")
        .OrderBy(c => c.Url())
        .ToList();

    if (!string.IsNullOrEmpty(selectedTag))
    {
        articles = articles
            .Where(c => (c.Value<IEnumerable<IPublishedContent>>("subjectTags") ?? Enumerable.Empty<IPublishedContent>())
                .Any(tag => tag.Key.ToString("N") == selectedTag))
            .ToList();
    }

    var totalPages = Math.Max(1, (int)Math.Ceiling(articles.Count / (double)pageSize));

    var pageQuery = Context.Request.Query["page"].FirstOrDefault();
    var currentPage = int.TryParse(pageQuery, out var parsedPage)
        ? Math.Clamp(parsedPage, 1, totalPages)
        : 1;

    var pagedArticles = articles
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    var listingUrl = Context.Request.Path.ToString();

    string PageUrl(int pageNumber)
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(selectedTag)) query.Add($"tag={selectedTag}");
        if (pageNumber > 1) query.Add($"page={pageNumber}");

        return query.Count == 0 ? listingUrl : $"{listingUrl}?{string.Join("&", query)}";
    }
}

<div class="news-list" style="max-width: 1400px; margin: auto; padding: 5%">
    @foreach (var article in pagedArticles)
    {
        @await Html.PartialAsync("newsThumbnail", article)
    }
</div>

@if (totalPages > 1)
{
    <nav class="pagination" style="display:flex; justify-content:center; align-items:center; gap:10px; margin: 30px 0;">
        @if (currentPage > 1)
        {
            <a class="light-link" href="@(PageUrl(currentPage - 1))">&laquo; Föregående</a>
        }

        @for (var i = 1; i <= totalPages; i++)
        {
            if (i == currentPage)
            {
                <span style="font-weight: 800;">@i</span>
            }
            else
            {
                <a class="light-link" href="@(PageUrl(i))">@i</a>
            }
        }

        @if (currentPage < totalPages)
        {
            <a class="light-link" href="@(PageUrl(currentPage + 1))">Nästa &raquo;</a>
        }
    </nav>
}
