@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Master.cshtml";

    var articles = Model.Children()
        .Where(c => c.ContentType.Alias == "newsArticle")
        .OrderByDescending(c => c.CreateDate);
}

<div class="featured-article">

</div>

<div class="promo-box"
     style="background-color:white; color: black;  min-height: 300px; clip-path: polygon(0 90px, 100% 0, 100% 200px, 0 100%); margin-top: 100px; display: flex; align-items: center; flex-direction: column; justify-content: center;">
    <p style="font-weight: 800; text-align: center; width:500px; letter-spacing: 0.1rem;">Teknikern är en självständig
        hemsida
        skapad för att
        ge ofiltrerade
        tech-nyheter. Joel Tommy Lindström, Joel Ringh, Felix Eklund, Hamze Osman och Edvin Fogelström
    </p>
    <a href="/om-oss" style="letter-spacing: 0.3rem; color: rgb(0, 0, 0);">LÄS MER</a>
</div>

<div class="news-list">
    @foreach (var article in articles)
    {
        @await Html.PartialAsync("newsThumbnail", article)
    }
</div>