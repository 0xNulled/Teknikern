@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "~/Views/Master.cshtml";

	var nyheter = Umbraco.Content(Guid.Parse("eacaa63c-4ca1-4b6e-8bec-456daeee5bb1"));

	var tagFolder = nyheter?.Children().FirstOrDefault(x => x.Name == "Nyhetsämnen Mapp");
	var tags = tagFolder?.Children().ToList() ?? new List<IPublishedContent>();

	var listingUrl = Context.Request.Path.ToString();
	var selectedTag = Context.Request.Query["tag"].FirstOrDefault();
}

<section class="articles">
	<div class="category_title"
			 style="margin-top: 20px; display:flex; gap: 10px; justify-items: center; justify-content: center;">
		<a class="outline-btn" href="@listingUrl" aria-pressed="@(string.IsNullOrEmpty(selectedTag) ? "true" : "false")"
			 style="text-decoration: none;">Alla</a>
		@foreach (var tag in tags)
		{
			var tagKey = tag.Key.ToString("N");

			<a class="outline-btn" href="@(listingUrl)?tag=@tagKey" aria-pressed="@(selectedTag == tagKey ? "true" : "false")"
				 style="text-decoration: none;">
				@(tag.Value<string>("subject") ?? tag.Name)
			</a>
		}
	</div>

	@if (nyheter != null)
	{
		@await Html.PartialAsync("newsListPartial", nyheter)
	}
</section>