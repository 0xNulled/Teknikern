@using Humanizer
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Master.cshtml";

    var articles = Model.Children()
        .Where(c => c.ContentType.Alias == "newsArticle")
        .OrderByDescending(c => c.CreateDate)
        .ToList();

    var allSubjects = articles
        .SelectMany(a => a.Value<IEnumerable<IPublishedContent>>("subjectTags") ?? Enumerable.Empty<IPublishedContent>())
        .Select(s => s.Value<string>("subject"))
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s)
        .ToList();

    var subjectFilter = Context.Request.Query["subject"].FirstOrDefault();
    if (!string.IsNullOrWhiteSpace(subjectFilter))
    {
        articles = articles
            .Where(a => (a.Value<IEnumerable<IPublishedContent>>("subjectTags") ?? Enumerable.Empty<IPublishedContent>())
                .Any(s => string.Equals(s.Value<string>("subject"), subjectFilter, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    var siteSettings = Umbraco.ContentAtRoot()
        .FirstOrDefault(x => x.ContentType.Alias == "siteSettings");

    var promoText = siteSettings?.Value<string>("promoText");

    const int pageSize = 9;
    var pageQuery = Context.Request.Query["page"].FirstOrDefault();
    var currentPage = int.TryParse(pageQuery, out var parsedPage) && parsedPage > 0 ? parsedPage : 1;

    var totalPages = Math.Max(1, (int)Math.Ceiling(articles.Count / (double)pageSize));
    if (currentPage > totalPages) { currentPage = totalPages; }

    var pagedArticles = articles
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    string PageLink(int page)
    {
        var query = $"page={page}";
        if (!string.IsNullOrWhiteSpace(subjectFilter))
        {
            query += $"&subject={Uri.EscapeDataString(subjectFilter)}";
        }
        return $"{Model.Url()}?{query}";
    }
}
@if (articles.Count > 0)
{
    <div class="featured-article">
        @{
            Random randomNumber = new Random();
            int randomArticle = randomNumber.Next(0, articles.Count);
        }

        @await Html.PartialAsync("featuredArticle", articles[randomArticle])

    </div>
}
<div class="promo-box"
     style="background-color:white; color: black;  min-height: 300px; clip-path: polygon(0 90px, 100% 0, 100% 200px, 0 100%); display: flex; align-items: center; flex-direction: column; justify-content: center;">
    <p style="font-weight: 800; text-align: center; width:500px; letter-spacing: 0.1rem;">
        @promoText
    </p>
    <a href="/om-oss" style="letter-spacing: 0.3rem; color: rgb(0, 0, 0);">LÄS MER</a>
</div>

<form method="get" action="@Model.Url()#news-list" style="text-align:center; margin: 20px 0;">
    <label for="subject-filter" style="margin-right: 8px;">Filtrera på ämne:</label>
    <select id="subject-filter" name="subject" onchange="this.form.submit()">
        <option value="">Alla ämnen</option>
        @foreach (var subject in allSubjects)
        {
            if (string.Equals(subject, subjectFilter, StringComparison.OrdinalIgnoreCase))
            {
                <option value="@subject" selected>@subject</option>
            }
            else
            {
                <option value="@subject">@subject</option>
            }
        }
    </select>
    <noscript>
        <button type="submit">Filtrera</button>
    </noscript>
</form>

<div class="news-list" id="news-list" style="max-width: 1400px; margin-left: auto; margin-right: auto;">
    @if (pagedArticles.Any())
    {
        @foreach (var article in pagedArticles)
        {
            @await  Html.PartialAsync("newsThumbnail", article)
        }
    }
    else
    {
        <p style="text-align:center;">Inga artiklar hittades.</p>
    }
</div>

@if (totalPages > 1)
{
    <nav class="pagination" style="display:flex; justify-content:center; align-items:center; gap:10px; margin: 30px 0;">
        @if (currentPage > 1)
        {
            <a href="@PageLink(currentPage - 1)">&laquo; Föregående</a>
        }

        @for (var i = 1; i <= totalPages; i++)
        {
            if (i == currentPage)
            {
                <span style="font-weight: 800;">@i</span>
            }
            else
            {
                <a href="@PageLink(i)">@i</a>
            }
        }

        @if (currentPage < totalPages)
        {
            <a href="@PageLink(currentPage + 1)">Nästa &raquo;</a>
        }
    </nav>
}