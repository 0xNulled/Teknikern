@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var selection = Umbraco.ContentAtRoot()
    .Where(x => x.ContentType.Alias != "siteSettings")
    .Where(x => x.IsVisible());

    var siteSettings = Umbraco.ContentAtRoot()
    .FirstOrDefault(x => x.ContentType.Alias == "siteSettings");

    var promoText = siteSettings?.Value<string>("promoText");
}

<!doctype html>
<html lang="sv">

<head>
    <meta charset="utf-8">
    <title>@Model.Name</title>
    <link rel="stylesheet" href="/css/style.css">
    @RenderSection("Head", required: false)
</head>

<body>
    <header style="text-align: center; border-bottom: 1px solid #fff; padding-bottom: 10px;">
        <h1>
            Teknikern</h1>
            <nav>
                @foreach (var item in selection)
                {
                    <li style="display: inline;">
                        [<a href="@item.Url()">@item.Name()</a>]
                    </li>
                }
            </nav>
        </header>

        <main style="flex: 1;">
            @RenderBody()
        </main>

        <footer>
            <div class="promo-box"
                 style="background-color:white; color: black;  min-height: 300px; clip-path: polygon(0 50px, 100% 0, 100% 250px, 0 100%); display: flex; align-items: center; flex-direction: column; justify-content: center;">
                <p style="font-weight: 800; text-align: center; width:500px; letter-spacing: 0.1rem;">@promoText
                </p>
                <a href="/om-oss" style="letter-spacing: 0.3rem; color: rgb(0, 0, 0);">LÄS MER</a>
            </div>
            <p style="text-align: center; letter-spacing: 0.1rem; font-style: italic; font-weight: 100;">© 2026 Teknikern.
                Made with
                Umbraco.</p>
            </footer>

        </body>

    </html>