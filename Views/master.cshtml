@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var selection = Umbraco.ContentAtRoot()
    .Where(x => x.IsVisible());
}

<!doctype html>
<html lang="sv">

<head>
    <meta charset="utf-8">
    <title>@Model.Name</title>
    <link rel="stylesheet" href="/css/style.css">
    @RenderSection("Head", required: false)
</head>

<body>
    <header style="text-align: center; border-bottom: 1px solid #fff; padding-bottom: 10px;">
        <h1>
            Teknikern</h1>
            <nav>
                @foreach (var item in selection)
                {
                    <li style="display: inline;">
                        [<a href="@item.Url()">@item.Name()</a>]
                    </li>
                }
            </nav>
        </header>

        <main style="flex: 1;">
            @RenderBody()
        </main>

        <footer>
            <p style="text-align: center; margin-top: auto; border-top: 1px solid #fff; padding-top: 10px;">footer</p>
        </footer>

    </body>

</html>