@using Umbraco.Cms.Core.Media.EmbedProviders
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "~/Views/Master.cshtml";

	var nyheter = Umbraco.ContentAtRoot().FirstOrDefault(x => x.Name == "Nyheter");

	var newsArticles = nyheter?.Children()
			.Where(x => x.ContentType.Alias == "newsArticle")
			?? Enumerable.Empty<IPublishedContent>();
	
	var children = nyheter?.Children()
			.Where(X => X.Name == "Nyhetsämnen Mapp");

	//Behövs en variabel som trackar vilken kategori vi vill rendera
}

<section class="articles">
	<div class="theGrid">
		@foreach (var category in children)
		{
			var categoryPage = category.Children().FirstOrDefault();

			@if (categoryPage != null)
			{
				<div class="category_title">
					<button> @categoryPage.Name</button> @{
					/*Ändra en variabel här för att sortera efter*/
				}
			</div>
		}
	}

	<div class="news-list" style="max-width: 1400px; margin-left: auto; margin-right: auto;">
		@foreach (var article in newsArticles)
		{
			@await Html.PartialAsync("newsThumbnail", article)
			/*Rendera bara utifrån sorteringen*/
		}
	</div>
</div>
</section>