@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.OmOss>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = null;
	var picture = Model.Value<IPublishedContent>("picture");
}
<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
	<h1>@Model.Value("title")</h1>

    <p>@Model.Value("textin")</p>

	@{
		if (picture != null)
		{
			<img src="@picture.Url()"/>
		}
	}
</body>
</html>