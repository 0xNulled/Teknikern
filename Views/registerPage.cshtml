@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "~/Views/Master.cshtml";
}

<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh; flex-direction: column">
	<h1 style="letter-spacing: 0.25rem; font-weight: 100">SKAPA KONTO</h1>
	<div
		style="display: flex; flex-direction: column; width: 400px; border: 1px solid white; padding: 0px 20px 0px 20px; height: 450px;">
		<p>Användarnamn</p>
		<input style="height: 30px" />
		<p style="margin-top: 40px">Lösenord</p>
		<input type="password" style="height: 30px;" />
		<p>Bekräfta Lösenord</p>
		<input type="password" style="height: 30px" />
		<div style="display: flex; align-items: center; justify-content: center; margin-top: 40px">
			<button class="primary-btn" style="width: 60%;">Registrera konto</button>
		</div>
		<p style="margin-top: 20px; margin-left: auto; margin-right: auto; font-size: 13px">Har du redan ett konto?<a
			href="logga-in" style="text-decoration: underline; margin-left: 10px;">LOGGA IN</a></p>
		</div>
	</div>